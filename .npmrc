# Workspace install-behaviour settings (save-exact, engine-strict, peer handling, hoisting) live in
# pnpm-workspace.yaml, not here -- verified against pnpm 11.15.0, where `.npmrc` silently ignores
# those keys for `pnpm add`/`pnpm install`. This file is for the handful of settings that are still
# genuinely `.npmrc`'s: registry/network behaviour. No custom registry or auth token is needed for
# this project (public npm registry only); the two settings below are resilience defaults for a
# ministry network that may be flaky or proxied.
fetch-retries=5
fetch-timeout=60000
# Also protect the isolated npm-managed browser test dependencies in e2e/.
min-release-age=7
