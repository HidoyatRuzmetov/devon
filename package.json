{
  "name": "devon",
  "private": true,
  "version": "0.0.0",
  "description": "Devon (WorkPortal) -- internal team and work platform for a department of Uzbekistan's Ministry of Digital Technologies",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "setup": "node setup.mjs",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs",
    "security:scan": "node tools/security/scan.mjs",
    "perf:check": "node tools/perf/check.mjs",
    "knip": "knip --config tools/knip/knip.jsonc",
    "madge": "node tools/madge/check.mjs",
    "arch:urls": "node tools/arch/no-hardcoded-urls.mjs",
    "arch:check": "pnpm run madge && pnpm run arch:urls && pnpm run knip"
  },
  "devDependencies": {
    "knip": "6.34.0",
    "madge": "8.0.0",
    "turbo": "2.10.12"
  }
}
