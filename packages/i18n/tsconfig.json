{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../config/tsconfig/node.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node", "react"],
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "test/vitest.config.ts"]
}
