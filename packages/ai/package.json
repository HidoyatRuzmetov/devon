{
  "name": "@devon/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GLM-5.2 gateway (TECH-SPEC §8): the OpenAI-compatible chat call, tool-call Zod validation, per-department UZS budgets, per-call traces, feature flags, a mock provider, and one prompt+schema per AI feature.",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
