    "test:unit": "vitest run --config test/vitest.config.ts",
    "build": "tsc -p tsconfig.json",
    "evals": "tsx evals/run.ts"
  },
  "dependencies": {
    "@devon/contracts": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@devon/config": "workspace:*",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "prettier": "3.7.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
