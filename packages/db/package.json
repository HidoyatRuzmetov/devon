{
  "name": "@devon/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, tenancy registry, audit chain, RLS and withContext -- the only path to Postgres.",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --config ../config/eslint/base.js . && prettier --check --config ../config/prettier.config.js --ignore-unknown \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\" \"*.json\"",
    "test:unit": "vitest run --config test/vitest.config.ts",
    "build": "tsc -p tsconfig.json",
    "migrate:verify": "tsx test/migrate-verify.ts",
    "tenancy:report": "tsx test/tenancy-report.ts",
    "audit:prove": "tsx test/audit-prove.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@devon/config": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "prettier": "3.7.1",
    "testcontainers": "12.1.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
