{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../config/tsconfig/react.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "storybook-static",
    ".storybook",
    "src/test-config/vitest.config.ts"
  ]
}
