{
  "name": "@devon/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "The single can() permission function, the RFC 9457 Problem shape, and the field-tier vocabulary shared by every Devon package. No runtime dependency beyond zod (design.md §1.1/§1.2).",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --config ../config/eslint/base.js . && prettier --check --config ../config/prettier.config.js --ignore-unknown \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\"",
    "test:unit": "vitest run --config test/vitest.config.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@devon/config": "workspace:*",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "prettier": "3.7.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
