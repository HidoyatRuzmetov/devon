{
  "name": "@devon/miniapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram Mini App (v1.1 SPEC §9, EPIC-015): WorkPortal's inbox, board peek, events, polls, focus timer and today list, sized for the Telegram webview.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --config src/vite.config.ts",
    "build": "vite build --config src/vite.config.ts",
    "preview": "vite preview --config src/vite.config.ts",
    "typecheck": "tsc --noEmit -p src/tsconfig.json",
    "lint": "eslint --config src/lint/eslint.config.js . && prettier --check --config ../../packages/config/prettier.config.js --ignore-unknown \"src/**/*.{ts,tsx,css,html}\" \"test/**/*.{ts,tsx}\" \"*.json\"",
    "test:unit": "vitest run --config test/vitest.config.ts"
  },
  "dependencies": {
    "@devon/contracts": "workspace:*",
    "@devon/i18n": "workspace:*",
    "@devon/ui": "workspace:*",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@devon/config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.10.0",
    "globals": "15.15.0",
    "jsdom": "30.0.1",
    "prettier": "3.7.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
