# Devon (WorkPortal) -- production image for the `worker` Compose service (H17 build, H18 deployment,
# H12.1 "worker horizontally scalable").
#
# Build from the REPO ROOT, same as apps/api/Dockerfile:
#   docker build -f apps/api/Dockerfile.worker -t devon-worker:<tag> .
#
# This optional service currently uses the same production runtime and server.ts entrypoint as
# the API, including its HTTP listener and durable background workers. The single-server deploy
# script does not launch this extra replica. Enable it only when additional worker capacity is
# intended; it is not a separate worker-only executable. Domain-event locking and fired guards
# coordinate replicated workers. A future worker-only entrypoint should change this CMD explicitly.
# Only production dependencies are installed; tsx is a production dependency because workspace
# packages export TypeScript source. Graceful shutdown is registered in server.ts.
#
# syntax=docker/dockerfile:1
ARG NODE_IMAGE=node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

FROM ${NODE_IMAGE} AS base
RUN corepack enable && corepack prepare pnpm@11.15.0 --activate
WORKDIR /repo

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/ai/package.json packages/ai/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN pnpm install --frozen-lockfile --prod

FROM ${NODE_IMAGE} AS runtime
WORKDIR /repo
# Runtime has no package managers or their bundled dependency trees.
RUN rm -rf /usr/local/lib/node_modules /opt/yarn-v* /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
ENV NODE_ENV=production
RUN addgroup -g 10001 -S devon && adduser -u 10001 -S devon -G devon
COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/package.json ./package.json
COPY --from=deps /repo/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY packages/config packages/config
COPY packages/contracts packages/contracts
COPY packages/db packages/db
COPY packages/ai packages/ai
COPY packages/i18n packages/i18n
COPY apps/api apps/api

COPY --from=deps /repo/packages/contracts/node_modules packages/contracts/node_modules
COPY --from=deps /repo/packages/db/node_modules packages/db/node_modules
COPY --from=deps /repo/packages/ai/node_modules packages/ai/node_modules
COPY --from=deps /repo/packages/i18n/node_modules packages/i18n/node_modules
COPY --from=deps /repo/apps/api/node_modules apps/api/node_modules
WORKDIR /repo/apps/api
RUN mkdir -p .data/storage && chown -R devon:devon /repo/apps/api/.data
USER devon:devon
EXPOSE 3000
# Not published by Caddy/Compose for this service (see infra/docker-compose.prod.yml's `worker`
# entry -- no `ports:`), but the process still answers on it, and it is the one signal this image can
# give an orchestrator that the background loops' host process is alive without inventing a second
# health surface that does not exist in the application code.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD wget -q -O- http://127.0.0.1:3000/healthz || exit 1
CMD ["node_modules/.bin/tsx", "src/server.ts"]
