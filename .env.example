# Devon (WorkPortal) -- environment variables.
# Copy this file to .env before running `pnpm setup` / `node setup.mjs`. Never commit .env (I-17).
# Every value below is a safe local-dev default; NODE_ENV=production refuses to boot if any of the
# marked defaults are still in place (design.md §7.4 boot guard, H7.3, H17.1).

# --- Runtime ---
NODE_ENV=development
DEVON_PUBLIC_URL=http://localhost:5173
API_PORT=3000
WEB_PORT=5173
LOG_LEVEL=info

# --- Postgres 17 ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=devon
POSTGRES_SUPERUSER_PASSWORD=devon_local_dev_root
POSTGRES_MIGRATOR_USER=devon_migrator
POSTGRES_MIGRATOR_PASSWORD=devon_local_dev_migrator
POSTGRES_APP_USER=devon_app
POSTGRES_APP_PASSWORD=devon_local_dev_app
DATABASE_URL=postgres://devon_app:devon_local_dev_app@127.0.0.1:55432/devon
MIGRATION_DATABASE_URL=postgres://devon_migrator:devon_local_dev_migrator@127.0.0.1:55432/devon

# --- Valkey (sessions cache, rate limits) ---
VALKEY_URL=redis://127.0.0.1:56379

# --- Sessions / CSRF (ADR-003: Postgres is the sole revocation record) ---
SESSION_COOKIE_NAME=devon_sid
SESSION_IDLE_MINUTES=720
SESSION_ABSOLUTE_DAYS=30
CSRF_SECRET=devon_local_dev_csrf_secret_change_in_production

# --- Audit chain anchor (I-5a) ---
AUDIT_ANCHOR_PATH=./.data/audit-anchor.log

# --- Setup / demo / e2e flags ---
# DEVON_SETUP_REMOTE=1 allows the one-time super-admin setup URL (AC-12) to be reachable from a
# non-loopback address; leave at 0 unless you are behind a tunnel you trust.
DEVON_SETUP_REMOTE=0
# DEVON_DEMO=1 is equivalent to `pnpm start --demo` (ADR-013); refused under NODE_ENV=production
# unless the flag is explicit (AC-2).
DEVON_DEMO=0
# DEVON_E2E=1 compiles in the ?__state=... forcing hooks used by the Playwright suite (AC-7); dead
# code eliminated from production builds otherwise.
DEVON_E2E=0

# --- infra/sentinel (loopback-only, signed no-op command in this epic -- ADR-011) ---
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8787
SENTINEL_PUBLIC_KEY=
