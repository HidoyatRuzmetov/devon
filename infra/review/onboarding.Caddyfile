:8080 {
  handle_path /review/* {
    root * /srv/review
    file_server
  }
  handle /api/* {
    reverse_proxy api:3000 {
      header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
    }
  }
  handle /healthz {
    reverse_proxy api:3000
  }
  handle /readyz {
    reverse_proxy api:3000
  }
  handle /connection/* {
    reverse_proxy centrifugo:8000
  }
  handle {
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; frame-src 'self'; child-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    header X-Frame-Options "DENY"
    reverse_proxy web:8080
  }
}
