[Unit]
Description=Weekly Devon (WorkPortal) restore drill

[Timer]
# Sunday 04:30 -- after devon-backup.timer (daily 02:15) and devon-backup-verify.timer (Sun 03:30),
# so the drill always runs against a backup the cheap schema check has already looked at.
OnCalendar=Sun *-*-* 04:30:00
Persistent=true
RandomizedDelaySec=900

[Install]
WantedBy=timers.target
